<!--
  Hardened runtime with no exceptions. Mac Mail is deliberately not sandboxed (sandboxing would move the
  mail cache and Keychain items), so it needs no network/file entitlements. Each exception added here must
  be documented in docs/security.md.
-->
<plist version="1.0">
<dict/>
</plist>
